# Copy this file to `.env` for local development.
#
# These values are inlined into the built site, so only put information you are
# happy to publish. Leaving them empty simply omits the corresponding contact
# link. In CI these come from GitHub Actions repository variables, not from this
# file.

# Public contact email, shown as a mailto: link.
VITE_CONTACT_EMAIL=

# Full URL to your public GitHub profile.
VITE_CONTACT_GITHUB=

# Full URL to your public LinkedIn profile.
VITE_CONTACT_LINKEDIN=
